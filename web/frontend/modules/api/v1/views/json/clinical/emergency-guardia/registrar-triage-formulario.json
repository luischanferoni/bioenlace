{
  "ui_type": "ui_json",
  "title": "Registrar triage",
  "ui_meta": {
    "schema_version": "1",
    "clients": {
      "*": { "min_app_version": "1.0.0" },
      "personalsalud-flutter": { "min_app_version": "1.0.0" }
    }
  },
  "blocks": [
    {
      "kind": "fields",
      "id": "triage",
      "title": "Triage Manchester",
      "fields": [
        {
          "name": "guardia_id",
          "label": "ID guardia",
          "type": "hidden",
          "required": true,
          "readonly": true
        },
        {
          "name": "level",
          "label": "Prioridad (Manchester)",
          "type": "chips",
          "required": true,
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" },
            { "value": "5", "label": "5" }
          ]
        },
        {
          "name": "reason_text",
          "label": "Motivo de consulta",
          "type": "textarea",
          "required": true,
          "rows": 3
        },
        {
          "name": "bp_sys",
          "label": "TA sistólica (opcional)",
          "type": "text",
          "required": false,
          "inputmode": "numeric",
          "maxlength": 3,
          "pattern": "^\\d{2,3}$",
          "hint": "Entero 50–250 (2–3 dígitos)"
        },
        {
          "name": "bp_dia",
          "label": "TA diastólica (opcional)",
          "type": "text",
          "required": false,
          "inputmode": "numeric",
          "maxlength": 3,
          "pattern": "^\\d{2,3}$",
          "hint": "Entero 30–150 (2–3 dígitos)"
        },
        {
          "name": "hr",
          "label": "FC (opcional)",
          "type": "text",
          "required": false,
          "inputmode": "numeric",
          "maxlength": 3,
          "pattern": "^\\d{2,3}$",
          "hint": "Entero 20–250 (2–3 dígitos)"
        }
      ]
    }
  ]
}
