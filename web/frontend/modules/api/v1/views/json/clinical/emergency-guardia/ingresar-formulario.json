{
  "ui_type": "ui_json",
  "title": "Ingreso a guardia",
  "ui_meta": {
    "schema_version": "1",
    "clients": {
      "*": { "min_app_version": "1.0.0" },
      "personalsalud-flutter": { "min_app_version": "1.0.0" }
    }
  },
  "actions": [
    { "type": "submit", "label": "Registrar ingreso", "primary": true }
  ],
  "blocks": [
    {
      "kind": "message",
      "id": "ayuda",
      "title": "",
      "text": "Buscá un paciente conocido por apellido o documento. Si no está en el sistema, completá el alta mínima. Quien ya está en la cola de este efector no aparece en la búsqueda."
    },
    {
      "kind": "fields",
      "id": "ingreso",
      "title": "Datos del ingreso",
      "fields": [
        {
          "name": "id_persona",
          "label": "Paciente conocido",
          "type": "autocomplete",
          "required": false,
          "endpoint": "/clinical/emergency-guardia/buscar-persona-ingreso",
          "auto_load": true,
          "show_search": true,
          "hint": "Si no aparece, registralo con los campos de alta."
        },
        {
          "name": "apellido",
          "label": "Apellido (alta)",
          "type": "text",
          "required": false,
          "max_length": 60,
          "hint": "Solo si el paciente no está en el sistema."
        },
        {
          "name": "nombre",
          "label": "Nombre (alta)",
          "type": "text",
          "required": false,
          "max_length": 60
        },
        {
          "name": "documento",
          "label": "Documento (alta)",
          "type": "text",
          "required": false,
          "max_length": 8
        },
        {
          "name": "fecha_nacimiento",
          "label": "Fecha de nacimiento (alta)",
          "type": "date",
          "required": false
        },
        {
          "name": "sexo_biologico",
          "label": "Sexo (alta)",
          "type": "select",
          "required": false,
          "options": [
            { "value": "1", "label": "Femenino" },
            { "value": "2", "label": "Masculino" }
          ]
        },
        {
          "name": "ingresa_en",
          "label": "Ingresa en",
          "type": "select",
          "required": true,
          "value": "deambula",
          "options": []
        },
        {
          "name": "ingresa_con",
          "label": "Ingresa con",
          "type": "select",
          "required": true,
          "value": "solo",
          "options": []
        },
        {
          "name": "datos_contacto_tel",
          "label": "Teléfono de contacto",
          "type": "text",
          "required": false,
          "max_length": 32,
          "hint": "Obligatorio si ingresa con familiar, policía u otro."
        },
        {
          "name": "situacion_al_ingresar",
          "label": "Situación al ingresar",
          "type": "textarea",
          "required": false,
          "rows": 2
        },
        {
          "name": "cobertura",
          "label": "Cobertura",
          "type": "text",
          "required": false,
          "max_length": 100
        }
      ]
    }
  ]
}
